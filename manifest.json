{
  "manifest_version": 3,
  "name": "PricePilot — Smart Shopping Compare",
  "version": "0.2.0",
  "description": "Price history, fake-discount check, card-offer net price, cross-store lookup, Zomato vs Swiggy. Local-only, no tracking.",
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": [
    "https://*.amazon.in/*",
    "https://*.amazon.com/*",
    "https://*.flipkart.com/*",
    "https://*.zomato.com/*",
    "https://*.swiggy.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.amazon.in/*", "https://*.amazon.com/*"],
      "js": ["lib/scoring.js", "lib/history.js", "lib/offers.js", "lib/reviews.js", "lib/unitprice.js", "lib/food.js", "content/common.js", "content/amazon.js", "content/overlay.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.flipkart.com/*"],
      "js": ["lib/scoring.js", "lib/history.js", "lib/offers.js", "lib/reviews.js", "lib/unitprice.js", "lib/food.js", "content/common.js", "content/flipkart.js", "content/overlay.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.zomato.com/*"],
      "js": ["lib/scoring.js", "lib/history.js", "lib/offers.js", "lib/reviews.js", "lib/unitprice.js", "lib/food.js", "content/common.js", "content/zomato.js", "content/overlay.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.swiggy.com/*"],
      "js": ["lib/scoring.js", "lib/history.js", "lib/offers.js", "lib/reviews.js", "lib/unitprice.js", "lib/food.js", "content/common.js", "content/swiggy.js", "content/overlay.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "PricePilot"
  }
}
